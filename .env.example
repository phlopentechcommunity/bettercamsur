# Application
NODE_ENV=production
APP_BASE_URL=https://bettercamsur.ph
PORT=3000

# External PostgreSQL (homelab service / Kubernetes later)
DATABASE_URL=postgresql://bettercamsur:CHANGE_ME@YOUR_POSTGRES_HOST:5432/bettercamsur
PG_POOL_MAX=15
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true

# External Redis (homelab service / Kubernetes later)
REDIS_URL=redis://:CHANGE_ME@YOUR_REDIS_HOST:6379/0

# Keycloak OIDC
KEYCLOAK_URL=https://sso.mitaka.quest
KEYCLOAK_REALM=bettercamsur
KEYCLOAK_CLIENT_ID=bettercamsur-web
KEYCLOAK_ADMIN_CLIENT_ID=bettercamsur-provisioner
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME

# Ceph RGW / S3-compatible object storage
S3_ENDPOINT=https://s3.mitaka.quest
S3_PUBLIC_URL=https://evidence.bettercamsur.ph
S3_REGION=us-east-1
S3_BUCKET=bettercamsur-evidence
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

# SMTP for invitations, access-request receipts, and report updates
SMTP_HOST=smtp.example.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@bettercamsur.ph
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=bettercamsur.ph <notifications@bettercamsur.ph>

